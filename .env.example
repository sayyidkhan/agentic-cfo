# Node
TZ=UTC
PORT=3333
HOST=localhost
NODE_ENV=development

# App
LOG_LEVEL=info
APP_KEY=
APP_URL=http://${HOST}:${PORT}

# Session
SESSION_DRIVER=cookie
# CFO defaults to local guided mode. No AI key or gateway required.
# Signing into ChatGPT/Codex to develop does not automatically give the
# independently hosted AdonisJS app a subscription-backed API endpoint.
#
# OPTIONAL: If you explicitly choose a separate direct API integration later,
# supply these values server-side. API charges are separate from ChatGPT plans.
CFO_AI_API_KEY=
CFO_AI_MODEL=
CFO_AI_BASE_URL=https://api.openai.com/v1

# Production POC security: public registration disabled unless explicitly true
# Temporarily set true to create your first account, then turn it off.
CFO_ALLOW_SIGNUP=false

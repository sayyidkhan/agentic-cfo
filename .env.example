# Node
TZ=UTC
PORT=3333
HOST=localhost
NODE_ENV=development

# App
LOG_LEVEL=info
APP_KEY=
APP_URL=http://${HOST}:${PORT}

# Session
SESSION_DRIVER=cookie
# Preferred: one shared LiteLLM model gateway across supported deployments.
# Set all three values; LITELLM_API_KEY is a restricted gateway key, NOT a ChatGPT login.
# Use HTTPS when accessing the gateway across services. Do not put these values in a public frontend.
LITELLM_BASE_URL=
LITELLM_API_KEY=
LITELLM_MODEL=agentic-cfo

# Legacy direct Chat Completions provider fallback (if LiteLLM is not configured).
# Optional conversational CFO integration (server-side only, never commit real credentials)
# Requires a Chat Completions-compatible model with function/tool calling.
CFO_AI_API_KEY=
CFO_AI_MODEL=
CFO_AI_BASE_URL=https://api.openai.com/v1

# Production POC security: public registration disabled unless explicitly true
# Temporarily set true to create your first account, then turn it off.
CFO_ALLOW_SIGNUP=false
